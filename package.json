{
  "name": "miranencheva-com",
  "version": "1.0.0",
  "private": true,
  "description": "Personal academic website for Mira Nencheva",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "serve": "node build.mjs && node --run serve:only",
    "serve:only": "npx --yes serve dist -l 8080",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "sharp": "^0.33.5",
    "wrangler": "^4.42.0"
  },
  "engines": {
    "node": ">=22"
  }
}
