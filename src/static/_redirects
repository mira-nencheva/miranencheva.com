# Redirect rules. One per line:  FROM  TO  STATUS
# 301 = permanent, which is what passes SEO value from an old URL to the new one.
#
# WARNING: never write a rule whose FROM is "/" — that redirects the homepage
# to itself and takes the whole site down with a redirect loop. Query strings
# (e.g. "/?page_id=5") are NOT matched here; the path is all that is compared,
# so such a rule silently becomes "/" and causes exactly that loop.

# Old WordPress.com paths -> new equivalents
/home                /                          301
/about               /                          301
/about-me            /                          301
/blog                /                          301
/blog/*              /                          301
/feed                /                          301
/feed/*              /                          301
/comments/feed       /                          301
/wp-admin/*          /                          301
/wp-login.php        /                          301

# The research page is currently unpublished (see src/drafts/) — send any
# existing links to the publications page instead of a 404.
/research            /publications/             301
/research/*          /publications/             301
/research.html       /publications/             301

# Friendly short URLs
/cv.pdf              /cv/Mira-Nencheva-CV.pdf   301
/publications.html   /publications/             301
/scholar             https://scholar.google.com/citations?user=MutwDoMAAAAJ&hl=en  302
